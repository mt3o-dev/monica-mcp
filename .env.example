# Copy to .env and fill in. .env is gitignored; .env.example is not.
# Never put the real token in .env.example.

# Base URL of the Monica instance, no trailing slash.
MONICA_BASE_URL=https://monica.example.com

# API token for the DEVELOPMENT account, from Settings -> API.
# This must not be the token for the account holding real contacts.
MONICA_API_TOKEN=

# The account the token must belong to. Checked against /api/me at startup;
# the server refuses to start on a mismatch, so a wrong token cannot write
# test data into the real account. Use the dev account's email or id.
MONICA_EXPECTED_ACCOUNT=

# Credential callers must present to reach this server. Any long random
# string: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Optional. Port for the HTTP transport. Default 8779.
# MCP_PORT=8779

# Docker network the container joins. compose.yml reads this so the committed
# file carries no infrastructure names.
# DOCKER_NETWORK=mcp-net
